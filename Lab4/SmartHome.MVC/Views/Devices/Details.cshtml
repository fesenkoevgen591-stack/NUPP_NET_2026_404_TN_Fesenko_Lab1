@model SmartHome.Infrastructure.Models.DeviceModel

@{
    ViewData["Title"] = "Відомості про пристрій";
}

<h1>@ViewData["Title"]</h1>

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            Назва
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            У мережі
        </dt>
        <dd class = "col-sm-10">
            @(Model.IsOnline ? "Так" : "Ні")
        </dd>
        <dt class = "col-sm-2">
            Кімната
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Редагувати</a> |
    <a asp-action="Index">До списку</a>
</div>
