@model SmartHome.Infrastructure.Models.RoomModel

@{
    ViewData["Title"] = "Видалити кімнату";
}

<h1>@ViewData["Title"]</h1>

<p>Підтвердьте видалення кімнати. Її пристрої також буде видалено.</p>
<div>
    <dl class="row">
        <dt class = "col-sm-2">
            Назва
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Поверх
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Floor)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Видалити" class="btn btn-danger" /> |
        <a asp-action="Index">До списку</a>
    </form>
</div>
